# Jarvis Dashboard Configuration

# Root directory for data files (fallback to ./data)
JARVIS_DATA_ROOT=./data

# Optional: OpenClaw project root directory
OPENCLAW_ROOT=C:\path\to\openclaw

# Optional: Override specific OpenClaw file paths
OPENCLAW_AGENTS_PATH=
OPENCLAW_CRONS_PATH=
OPENCLAW_BOTS_PATH=

# Example Windows PowerShell usage:
# Copy this file to .env and adjust paths
# $env:JARVIS_DATA_ROOT="C:\Users\John\jarvis-data"  
# $env:OPENCLAW_ROOT="C:\OpenClaw"